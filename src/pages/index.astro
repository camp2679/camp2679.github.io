---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';

const base = import.meta.env.BASE_URL;
const url = (p) => (base.replace(/\/$/, '') + p) || '/';
---

<Base title={null} description={site.bio[0]}>
  <section class="intro">
    <img class="intro__photo" src={url(site.photo)} alt={site.photoAlt} width="132" height="132" />

    <div>
      <h1 class="intro__name">{site.name}</h1>
      {site.tagline && <p class="intro__tagline">{site.tagline}</p>}
    </div>
  </section>

  <div class="bio">
    {site.bio.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  {
    site.links.length > 0 && (
      <ul class="linkrow">
        {site.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
