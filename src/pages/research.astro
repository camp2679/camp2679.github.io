---
import Base from '../layouts/Base.astro';
import { workingPapers, workInProgress, publications } from '../data/site.js';

const base = import.meta.env.BASE_URL;
const url = (p) => (base.replace(/\/$/, '') + p) || '/';

// Turns **your name** into bold text in the author list.
const bold = (s = '') => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

const paras = (a) => (Array.isArray(a) ? a : [a]);

// The sections, in the order they appear on the page.
// A section with an empty list is dropped automatically.
const sections = [
  { heading: 'Working Papers', items: workingPapers },
  { heading: 'Work in Progress', items: workInProgress },
  { heading: 'Selected Publications', items: publications },
].filter((s) => s.items && s.items.length > 0);
---

<Base title="Research" description="Working papers, work in progress, and selected publications.">
  <h1 class="page-title">Research</h1>

  <p class="page-intro">
    Below are my working papers and current work in progress, as well as a list of select publications. For a full list of my work, please refer to my{' '}<a href={url('/cv')}>CV</a>.
  </p>

  {
    sections.map((section) => (
      <section class="research-section">
        <h2 class="section-title">{section.heading}</h2>

        <ul class="pubs">
          {section.items.map((pub) => (
            <li class="pub">
              <h3 class="pub__title">{pub.title}</h3>

              {pub.authors && <p class="pub__authors" set:html={bold(pub.authors)}></p>}

              {(pub.venue || pub.year) && (
                <p class="pub__meta">
                  {pub.venue && <em>{pub.venue}</em>}
                  {pub.venue && pub.year && ', '}
                  {pub.year}
                </p>
              )}

              {pub.note && <p class="pub__note">{pub.note}</p>}

              {pub.abstract && (
                <details class="abstract">
                  <summary>Abstract</summary>
                  <div class="abstract__body">
                    {paras(pub.abstract).map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                </details>
              )}

              {pub.links && pub.links.length > 0 && (
                <ul class="pub__links">
                  {pub.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
