---
import '../styles/global.css';
import { site } from '../data/site.js';

const { title, description } = Astro.props;

// Build links that work whether the site is served from the domain
// root (username.github.io) or a subfolder (username.github.io/repo).
const base = import.meta.env.BASE_URL;
const url = (p) => (base.replace(/\/$/, '') + p) || '/';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (p) => path === (url(p).replace(/\/$/, '') || '/');

const pageTitle = title ? `${title} — ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
  </head>

  <body>
    {
      site.banner && (
        <img
          class="banner"
          src={url(site.banner)}
          alt={site.bannerAlt || ''}
          style={`--banner-h: ${site.bannerHeight || 'clamp(110px, 18vw, 190px)'}`}
        />
      )
    }

    <div class="shell">
      <header class="site-header">
        <a class="site-header__name" href={url('/')}>{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          {
            site.nav.map((item) => {
              // A link to another site, or to a file like a PDF, opens in a
              // new tab and never gets the "current page" underline.
              const isExternal = /^https?:\/\//.test(item.href);
              const isFile = /\.[a-z0-9]+$/i.test(item.href);
              const away = isExternal || isFile;

              return (
                <a
                  href={isExternal ? item.href : url(item.href)}
                  aria-current={!away && isCurrent(item.href) ? 'page' : undefined}
                  target={away ? '_blank' : undefined}
                  rel={away ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {site.name}</p>
      </footer>
    </div>
  </body>
</html>
