---
import '../styles/global.css';
import { site } from '../data/site.js';

const { title, description } = Astro.props;

// Build links that work whether the site is served from the domain
// root (username.github.io) or a subfolder (username.github.io/repo).
const base = import.meta.env.BASE_URL;
const url = (p) => (base.replace(/\/$/, '') + p) || '/';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (p) => path === (url(p).replace(/\/$/, '') || '/');

const pageTitle = title ? `${title} — ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
  </head>

  <body>
    <div class="shell">
      <header class="site-header">
        <a class="site-header__name" href={url('/')}>{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          <a href={url('/research')} aria-current={isCurrent('/research') ? 'page' : undefined}>
            Research
          </a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {site.name}</p>
      </footer>
    </div>
  </body>
</html>
